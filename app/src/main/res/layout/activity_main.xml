<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050C">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TWSCTRL"
            android:textColor="#00F5FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGUARDANDO..."
            android:textColor="#555555"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/card_outline"
                android:layout_marginEnd="8dp">
                <View
                    android:id="@+id/led_left"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/led_off"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:text="ESQUERDO"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="8sp"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tv_bat_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="L: --"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/card_outline">
                <View
                    android:id="@+id/led_right"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/led_off"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:text="DIREITO"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="8sp"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tv_bat_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R: --"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:id="@+id/btn_scan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="BUSCAR FONE"
            android:textColor="#00F5FF"
            android:background="@drawable/btn_scan"
            android:layout_marginBottom="16dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VOLUME"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
                <Switch
                    android:id="@+id/sw_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYNC"
                    android:textColor="#555555"
                    android:textSize="9sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:text="ESQ"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
                <SeekBar
                    android:id="@+id/sb_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#00F5FF"
                    android:thumbTint="#00F5FF"/>
                <TextView
                    android:id="@+id/tv_left_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="65%"
                    android:textColor="#00F5FF"
                    android:textSize="12sp"
                    android:textAlignment="textEnd"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">
                <TextView
                    android:text="DIR"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
                <SeekBar
                    android:id="@+id/sb_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#00F5FF"
                    android:thumbTint="#00F5FF"/>
                <TextView
                    android:id="@+id/tv_right_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="65%"
                    android:textColor="#00F5FF"
                    android:textSize="12sp"
                    android:textAlignment="textEnd"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MICROFONE"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
                <Switch
                    android:id="@+id/sw_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ATIVO"
                    android:textColor="#555555"
                    android:textSize="9sp"
                    android:checked="true"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:text="MIC"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
                <SeekBar
                    android:id="@+id/sb_mic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#B400FF"
                    android:thumbTint="#B400FF"/>
                <TextView
                    android:id="@+id/tv_mic_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#B400FF"
                    android:textSize="12sp"
                    android:textAlignment="textEnd"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CANCELAMENTO DE RUIDO"
                android:textColor="#555555"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
            <Switch
                android:id="@+id/sw_anc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
